{
  "name": "devidlabel-ai-assistant-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker backend for the Devid Label Shopify AI Assistant.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "validate:contract": "node scripts/validate-contract.mjs",
    "test:recommendations": "node scripts/test-recommendations.mjs",
    "test:diagnostics": "node scripts/test-diagnostics.mjs",
    "test:category-ranking": "node scripts/test-category-ranking.mjs",
    "test:recommendation-engine-v2": "node scripts/test-recommendation-engine-v2.mjs",
    "test:order-lookup": "node scripts/test-order-lookup.mjs",
    "test:order-chat-response": "node scripts/test-order-chat-response.mjs",
    "test:shopify-oauth": "node scripts/test-shopify-oauth.mjs",
    "test:shopify-reporting": "node scripts/test-shopify-reporting.mjs",
    "test:shopify-metafields": "node scripts/test-mare-shopify-metafields.mjs",
    "test:klaviyo-reporting": "node scripts/test-klaviyo-reporting.mjs",
    "test:meta-reporting": "node scripts/test-meta-reporting.mjs",
    "test:google-ads-reporting": "node scripts/test-google-ads-reporting.mjs",
    "test:search-console-reporting": "node scripts/test-search-console-reporting.mjs",
    "test:ga4-reporting": "node scripts/test-ga4-reporting.mjs",
    "test:mare-mcp": "node scripts/test-mare-mcp.mjs",
    "test:mare-operations-mcp": "node scripts/test-mare-operations-mcp.mjs",
    "test:mare-product-media-mcp": "node scripts/test-mare-product-media-mcp.mjs",
    "test:mare-business-mcp": "node scripts/test-mare-business-mcp.mjs && node scripts/test-mare-klaviyo-crm.mjs",
    "test:bilingual": "node scripts/test-bilingual-assistant.mjs",
    "test:conversation-router": "node scripts/test-conversation-router.mjs",
    "test:marketplace-routing": "node scripts/test-marketplace-routing.mjs",
    "probe:live-orders": "node scripts/probe-live-order-chat.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.20.5"
  }
}
